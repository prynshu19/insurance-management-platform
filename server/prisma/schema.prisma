generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  AGENT
  CUSTOMER
}

enum PolicyStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PolicyType {
  LIFE
  HEALTH
  AUTO
  HOME
  TRAVEL
  BUSINESS
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
  UNDER_REVIEW
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum DocumentType {
  ID_PROOF
  ADDRESS_PROOF
  POLICY_DOCUMENT
  CLAIM_DOCUMENT
  OTHER
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(CUSTOMER)
  isActive  Boolean  @default(true)

  customer  Customer?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([role])
}

model Customer {
  id        String    @id @default(cuid())
  fullName  String
  phone     String    @unique
  dob       DateTime
  address   String
  city      String?
  state     String?
  zipCode   String?

  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  policies  Policy[]
  documents Document[]

  deletedAt DateTime?  // soft delete

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([fullName])
  @@index([phone])
  @@index([userId])
}

model Policy {
  id            String       @id @default(cuid())
  policyNumber  String       @unique
  policyType    PolicyType
  description   String?
  coverageAmount Decimal
  premiumAmount Decimal
  startDate     DateTime
  endDate       DateTime
  status        PolicyStatus @default(ACTIVE)

  customerId    String
  customer      Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  claims        Claim[]
  payments      PremiumPayment[]
  documents     Document[]

  deletedAt     DateTime?    // soft delete

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([policyType])
  @@index([policyNumber])
}

model Claim {
  id             String      @id @default(cuid())
  claimNumber    String      @unique @default(cuid())
  claimAmount    Decimal
  reason         String
  description    String?
  status         ClaimStatus @default(PENDING)
  submissionDate DateTime    @default(now())
  resolvedDate   DateTime?
  reviewerNote   String?

  policyId       String
  policy         Policy      @relation(fields: [policyId], references: [id], onDelete: Cascade)

  documents      Document[]

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([policyId])
  @@index([status])
  @@index([submissionDate])
}

model PremiumPayment {
  id            String        @id @default(cuid())
  amount        Decimal
  paymentDate   DateTime      @default(now())
  dueDate       DateTime?
  paymentStatus PaymentStatus @default(PENDING)
  paymentMethod String?       // e.g. "CREDIT_CARD", "BANK_TRANSFER"
  transactionId String?       @unique

  policyId      String
  policy        Policy        @relation(fields: [policyId], references: [id], onDelete: Cascade)

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([policyId])
  @@index([paymentStatus])
  @@index([dueDate])
}

model Document {
  id           String       @id @default(cuid())
  fileName     String
  originalName String
  filePath     String
  fileType     DocumentType @default(OTHER)
  mimeType     String
  fileSize     Int          // in bytes

  customerId   String?
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)

  policyId     String?
  policy       Policy?      @relation(fields: [policyId], references: [id], onDelete: SetNull)

  claimId      String?
  claim        Claim?       @relation(fields: [claimId], references: [id], onDelete: SetNull)

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([customerId])
  @@index([policyId])
  @@index([claimId])
}