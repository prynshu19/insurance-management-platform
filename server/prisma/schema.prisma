generator client {
  provider = "prisma-client"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum Role{
  ADMIN
  AGENT
  CUSTOMER
}

enum PolicyStatus{
  ACTIVE
  EXPIRED
  CANCELLED
}

enum ClaimStatus{
  PENDING
  APPROVED
  REJECTED
}

enum PaymentStatus{
  PENDING
  PAID
  OVERDUE
}

model User{
  id    String @id @default(cuid())
  email  String @unique
  password  String
  role Role @default(CUSTOMER)

  customer CUSTOMER?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model customer{
  id String @id @default(cuid())
  fullName String
  phone String
  dob DateTime
  address String
  userId String @unique
  user User @relations(fields: [userId],references: [id])
  policies Policy[]
  documents Document[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

